---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SECTIONS } from '../consts';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro { margin-bottom: 2.5rem; }
			.intro h1 { margin-bottom: 0.3rem; }
			.tagline { color: rgb(var(--gray)); font-size: 1.1rem; }
			.sections { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin: 2rem 0 3rem; }
			.sections a { display: block; padding: 1.1rem 1.2rem; border: 1px solid rgb(var(--gray-light)); border-radius: 12px; text-decoration: none; transition: 0.2s ease; }
			.sections a:hover { box-shadow: var(--box-shadow); border-color: rgb(var(--accent)); }
			.sections h3 { margin: 0 0 0.25rem; color: rgb(var(--black)); }
			.sections p { margin: 0; color: rgb(var(--gray)); font-size: 0.95rem; }
			.latest li { list-style: none; margin: 0 0 1rem; padding: 0; }
			.latest a { text-decoration: none; }
			.latest .date { color: rgb(var(--gray)); font-size: 0.9rem; margin: 0; }
			.latest .title { margin: 0; color: rgb(var(--black)); }
			ul { padding: 0; }
			@media (max-width: 720px) { .sections { grid-template-columns: 1fr; } }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="intro">
				<h1>{SITE_TITLE}</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
			</div>

			<div class="sections">
				{SECTIONS.map((s) => (
					<a href={`/${s.slug}`}>
						<h3>{s.label}</h3>
						<p>{s.blurb}</p>
					</a>
				))}
			</div>

			<h2>Latest</h2>
			<ul class="latest">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<p class="date"><FormattedDate date={post.data.pubDate} /> · {post.data.category}</p>
							<h3 class="title">{post.data.title}</h3>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
