---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, GITHUB_URL, LINKEDIN_URL } from '../consts';
import LangMenu from './LangMenu.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/foreign-affairs">Int'l Affairs</HeaderLink>
			<HeaderLink href="/data">Data</HeaderLink>
			<HeaderLink href="/policy-room">Policy Room</HeaderLink>
			<HeaderLink href="/notes">Notes</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<LangMenu />
		<div class="social-links">
			<a href={LINKEDIN_URL} target="_blank" rel="noopener">
				<span class="sr-only">LinkedIn</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.82-2.05 3.75-2.05C20.4 8.65 21 11 21 14.1V21h-4v-6.1c0-1.45-.03-3.32-2.02-3.32-2.02 0-2.33 1.58-2.33 3.21V21H9z"/></svg>
			</a>
			<a href={GITHUB_URL} target="_blank" rel="noopener">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header { margin: 0; padding: 0 1em; background: var(--surface); border-bottom: 1px solid rgb(var(--gray-light)); }
	h2 { margin: 0; font-size: 1.15em; font-family: var(--font-head); font-weight: 600; letter-spacing: -0.01em; }
	h2 a, h2 a.active { text-decoration: none; }
	nav { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; }
	nav a { padding: 1em 0.5em; color: var(--black); border-bottom: 4px solid transparent; text-decoration: none; }
	nav a.active { text-decoration: none; border-bottom-color: var(--accent); }
	.social-links, .social-links a { display: flex; }
	@media (max-width: 720px) {
		.internal-links { font-size: 0.9em; }
	}
</style>
