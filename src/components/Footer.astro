---
import { SITE_TITLE, GITHUB_URL, LINKEDIN_URL } from '../consts';
const today = new Date();
---

<footer>
	<div class="links">
		<a href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>
		<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
		<a href="/about">About</a>
		<a href="https://app.pagescms.org/PurpleKIMLauren/purplekimlauren.github.io/main" target="_blank" rel="noopener" class="write">Write</a>
	</div>
	<p class="copy">&copy; {today.getFullYear()} {SITE_TITLE}. Open-source analysis; views are my own.</p>
</footer>
<style>
	footer { padding: 2.5em 1em 5em; background: linear-gradient(var(--gray-gradient)) no-repeat; color: rgb(var(--gray)); text-align: center; }
	.links { display: flex; justify-content: center; gap: 1.5em; margin-bottom: 0.8em; }
	.links a { color: rgb(var(--gray-dark)); text-decoration: none; font-weight: 600; }
	.links a:hover { color: var(--accent); }
	.links a.write { opacity: 0.55; }
	.links a.write:hover { opacity: 1; }
	.copy { margin: 0; font-size: 0.9em; }
</style>
